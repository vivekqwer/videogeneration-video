# Copy to .env and fill in. Never commit .env.

# Free Hugging Face token (read access) -> more free GPU quota.
# Create: https://huggingface.co/settings/tokens
HF_TOKEN=

# Optional: free Pexels key for ReelGen stock photos. https://www.pexels.com/api/
PEXELS_API_KEY=

# Dashboard bind address (keep 127.0.0.1 = only this PC)
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8000
